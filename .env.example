# RecSys local development template
# Copy only the variables required by the service you are running. Do not load
# this entire file into every process. Secret values intentionally remain blank.

# Source PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recsys
POSTGRES_USER=recsys
POSTGRES_PASSWORD=
POSTGRES_DSN=

# Feast PostgreSQL registry/offline store and Redis online store
FEAST_POSTGRES_HOST=localhost
FEAST_POSTGRES_PORT=5432
FEAST_POSTGRES_DB=feast
FEAST_POSTGRES_USER=feast
FEAST_POSTGRES_PASSWORD=
FEAST_SQL_REGISTRY_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3-compatible local object storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
LAKE_BUCKET=recsys-lakehouse
OFFLINE_FEATURE_BUCKET=recsys-feature-store
MODEL_STORE_BUCKET=recsys-model-store

# Kafka and streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
FEAST_ONLINE_CONSUMER_GROUP=recsys-online-features
FEAST_OFFLINE_CONSUMER_GROUP=recsys-offline-features
CHECKPOINT_INTERVAL_MS=60000
ALLOWED_LATENESS_SECONDS=300

# Milvus and RAG
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=
RAG_ACTIVE_SLOT=
RAG_EMBEDDING_DIMENSION=384
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=

# Local service URLs
FEATURE_API_URL=http://localhost:8081
ONLINE_FEATURE_API_URL=http://localhost:8081
INFERENCE_API_URL=http://localhost:8082
RAG_API_URL=http://localhost:8083
TRITON_URL=localhost:8001
MLFLOW_TRACKING_URI=http://localhost:5000
PROMETHEUS_URL=http://localhost:9090

# Service authentication; generate fresh values outside Git
MCP_AUTH_TOKEN=
MCP_AUTH_TOKEN_V1=
MCP_AUTH_TOKEN_V2=
AGENT_GATEWAY_API_KEY=
AB_INTERNAL_TOKEN=
AB_CASE_TICKET_KEY=
AB_TRIGGER_SECRET=
AB_TRIGGER_STATUS_TOKEN=
AB_LIVE_TEST_TOKEN=

# Langfuse (disabled until configured)
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PROJECT_ID=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_WEBHOOK_SECRET=

# Jenkins dispatch (disabled until configured)
JENKINS_URL=http://localhost:8080
JENKINS_USER=
JENKINS_TOKEN=
AB_JENKINS_URL=http://localhost:8080
AB_JENKINS_USER=
AB_JENKINS_TOKEN=
AB_DISPATCH_ENABLED=false

# DataHub
DATAHUB_GMS_URL=http://localhost:8088
DATAHUB_GMS_TOKEN=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=recsys

# Owner deployment inputs. Prefer untracked Terraform tfvars for Terraform.
GCP_PROJECT_ID=owner-project
GCP_REGION=asia-southeast1
GCP_ZONE=asia-southeast1-b
GCP_CLUSTER=
GCP_CONTEXT=
GCP_IMAGE_REGISTRY=registry.example.invalid/recsys
TERRAFORM_STATE_BUCKET=
GATEWAY_DOMAIN=example.invalid
LANGFUSE_DOMAIN=langfuse.example.invalid
GATEWAY_TLS_ISSUER_EMAIL=

# Smoke identities are derived from newly generated synthetic data.
AGENTIC_SMOKE_USER_ID=
AGENTIC_SMOKE_CHUNK_ID=
RECOMMENDATION_SMOKE_USER_ID=
COORDINATOR_SMOKE_USER_ID=
COORDINATOR_SMOKE_CHUNK_ID=

# Docker build arguments are supplied by the image catalog/build pipeline, not
# sourced into application processes: BASE_IMAGE, RUNTIME_IMAGE, IMAGE_DIGEST.
# Jenkins supplies BUILD_NUMBER, BUILD_URL, GIT_COMMIT and release-lock values.
# Shell-local variables documented in operations scripts are not dotenv inputs.
